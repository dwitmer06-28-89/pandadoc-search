{
  "name": "pandadoc-search",
  "version": "1.0.3",
  "description": "Global-hotkey search bar that opens PandaDoc document search results",
  "author": "Deron Witmer <deron@rooted.software>",
  "license": "MIT",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/dwitmer06-28-89/pandadoc-search.git"
  },
  "scripts": {
    "install-desktop": "bash scripts/install-desktop.sh",
    "start": "electron .",
    "build": "electron-builder --mac",
    "release": "electron-builder --mac --publish always"
  },
  "build": {
    "appId": "software.rooted.pandadoc-search",
    "productName": "PandaDoc Search",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "overlay-preload.js",
      "overlay.html",
      "shell-preload.js",
      "shell.html",
      "ai-preload.js",
      "ai.html",
      "assess.js",
      "config.js",
      "assets/**/*",
      "node_modules/darkreader/darkreader.js",
      "node_modules/darkreader/package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "dwitmer06-28-89",
        "repo": "pandadoc-search",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "PandaDoc Search"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.228",
    "darkreader": "^4.9.128",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^41.10.3",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@41.10.3": true
  }
}
